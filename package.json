    "@mui/material": "^9.4.0",
    "@mui/x-date-pickers": "^9.14.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "dayjs": "^1.11.23",
    "dexie": "^4.4.5",
