# Раздача собранного фронтенда внутри контейнера kttf-web.
#
# Наружу этот сервер не смотрит: перед ним стоит kttf-proxy, который держит
# домен, TLS и заголовки безопасности. Здесь только файлы.

:80 {
	root * /srv

	# Маршруты приложения существуют только в браузере: адрес вида
	# /tournaments/<id> на диске не файл. Всё, что не найдено, отдаётся
	# оболочкой, и дальше маршрут разбирает роутер.
	try_files {path} /index.html

	file_server

	# Файлы сборки Vite содержат хеш в имени: меняется содержимое — меняется
	# адрес, поэтому кешировать их можно надолго.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Оболочка и работник — наоборот, никогда. Закешированный sw.js означает
	# судью, который открыл консоль и получил прошлую версию приложения,
	# а обновление по требованию (ADR-004) до него так и не дошло.
	@volatile path /index.html /sw.js /registerSW.js /manifest.webmanifest
	header @volatile Cache-Control "no-cache"

	encode gzip zstd
}
